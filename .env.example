# Local storage is the default.
RESTIQ_STORAGE_DRIVER=local

# Optional R2 storage mode. Do not commit real secrets.
# RESTIQ_STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_BUCKET=restiq-assets
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_BASE_URL=https://assets.example.com
# Optional smoke-test target. Run with: npm run storage:r2:smoke
# RESTIQ_R2_SMOKE_RESTAURANT_ID=999999
